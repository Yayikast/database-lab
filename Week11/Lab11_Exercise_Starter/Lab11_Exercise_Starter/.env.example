# .env.example - a template: copy it to .env and fill in your own values.
# This file is safe to share; .env is not.
# Change DB_USER / DB_PASS to match YOUR MySQL installation.
# Lab 11 creates procedures, functions, triggers and a collection, which your
# Lab 10 least-privilege user is not allowed to do, so use your admin login here.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=your_mysql_password
DB_NAME=lab11

# X Protocol port for the document store (Exercise 5)
DB_X_PORT=33060

# port for the Express server
PORT=3000
